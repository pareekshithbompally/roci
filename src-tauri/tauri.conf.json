{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Roci",
  "version": "1.10.2",
  "identifier": "ai.roci.roci",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Roci",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "backgroundThrottling": "disabled",
        "center": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "windowEffects": {
          "effects": [
            "fullScreenUI",
            "mica",
            "tabbed",
            "blur",
            "acrylic"
          ],
          "state": "active"
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**", "$APPDATA/speech/**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "roci"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RUM2OTNFOTgxMTJCNDMKUldSREt4R1lQbW5zS1B3RTRzU1NtUzg0UUtUZlZVVm13dnNEcEx2NzV2MGpibzAzYldwZ1FaOHMK",
      "endpoints": [
        "https://github.com/pareekshithbompally/roci/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "resources/silero-vad-v6.2-F32.gguf": "silero-vad-v6.2-F32.gguf"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/compiled/AppIcon.icns"
    ],
    "publisher": "Roci",
    "copyright": "Copyright \u00a9 2026 Pareekshith Bompally",
    "category": "Productivity",
    "shortDescription": "Private meeting notes and AI chat for Mac, iPhone and iPad.",
    "longDescription": "Roci records your meetings and writes the transcript, summary and to-dos, privately on your device or with the AI you choose. Chat with any model about your meetings or anything else, on Mac, iPhone and iPad.",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "entitlements": "entitlements.plist",
      "frameworks": [
        "frameworks/RociMLX.framework"
      ],
      "infoPlist": "Info.plist",
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "iOS": {
      "developmentTeam": "8TV3HMU3KY",
      "minimumSystemVersion": "26.0",
      "bundleVersion": "1"
    }
  }
}
