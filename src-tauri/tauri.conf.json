{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Roci",
  "version": "1.2.0",
  "identifier": "ai.roci.roci",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Roci",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "backgroundThrottling": "disabled",
        "center": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "windowEffects": {
          "effects": [
            "fullScreenUI",
            "mica",
            "tabbed",
            "blur",
            "acrylic"
          ],
          "state": "active"
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "roci"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RUM2OTNFOTgxMTJCNDMKUldSREt4R1lQbW5zS1B3RTRzU1NtUzg0UUtUZlZVVm13dnNEcEx2NzV2MGpibzAzYldwZ1FaOHMK",
      "endpoints": [
        "https://github.com/pareekshithbompally/roci/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/AppIcon.icon"
    ],
    "resources": [
      "icons/iconTemplate.png",
      "icons/iconTemplate@2x.png",
      "icons/iconRecordingTemplate.png",
      "icons/iconRecordingTemplate@2x.png",
      "icons/agents/claude-code.png",
      "icons/agents/opencode.png"
    ],
    "publisher": "Roci",
    "copyright": "Copyright \u00a9 2026 Pareekshith Bompally",
    "category": "Productivity",
    "shortDescription": "AI-powered voice capture, transcription, and insights",
    "longDescription": "Roci is a powerful desktop application for real-time system audio capture, transcription, and intelligent summarization. Perfect for meetings, lectures, podcasts, and any audio content that needs to be transcribed and analyzed.",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "Developer ID Application: Pareekshith Bompally (8TV3HMU3KY)",
      "entitlements": "entitlements.plist",
      "frameworks": [],
      "infoPlist": "Info.plist",
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "iOS": {
      "developmentTeam": "8TV3HMU3KY",
      "minimumSystemVersion": "26.0",
      "bundleVersion": "1"
    }
  }
}
