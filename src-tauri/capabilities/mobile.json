{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "iOS and iPadOS: the shared shell",
  "windows": [
    "main"
  ],
  "platforms": [
    "iOS"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:default",
    "log:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:scope-appdata-recursive",
    "os:default",
    "opener:default",
    "store:default",
    "apple-intelligence:default",
    "notifications:default",
    "haptics:default",
    "calendar:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "app-settings:"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*"
        }
      ]
    }
  ]
}
